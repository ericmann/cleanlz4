      "pattern": "^\\s*(?!(?:name|version|edition|publish|path|test|doc|bench|cargo-fuzz|cleanlz4|oracle|lz4-sys|sha2|serde|serde_json|libfuzzer-sys)\\s*=)[A-Za-z0-9_.-]+\\s*=|^\\s*\\[\\s*(?:dev-|build-)?dependencies\\.|^\\s*\\[\\s*(?:dev-dependencies|build-dependencies|target\\.)",
      "shouldMatch": [
        "rand = \"0.8\"",
        "criterion = { version = \"0.5\", default-features = false }",
        "serde-big-array = \"0.5\"",
        "proptest.workspace = true",
        "[dependencies.rand]",
        "[dev-dependencies]",
        "[build-dependencies]",
        "[target.'cfg(unix)'.dependencies]",
        "arbitrary = { version = \"1\", features = [\"derive\"] }"
      ],
      "shouldNotMatch": [
        "[package]",
        "[dependencies]",
        "name = \"oracle\"",
        "version = \"0.2.0\"",
        "publish = false",
        "cleanlz4 = { path = \"../cleanlz4\" }",
        "lz4-sys = \"1\"",
        "serde = { version = \"1\", features = [\"derive\"] }",
        "serde_json = \"1\"",
        "libfuzzer-sys = \"0.4\"",
        "cargo-fuzz = true",
        "[[bin]]",
        "path = \"fuzz_targets/no_panic_block.rs\"",
        "test = false",
        "[workspace]",
        "[package.metadata]"
      ]
    },
    {
      "id": "cargo-stays-offline",
      "description": "SPEC 8 Phase 0 and the clean-room policy: .cargo/config.toml keeps net.offline = true; nothing switches cargo back online or adds a registry or source replacement.",
      "paths": [
        ".cargo/config.toml"
      ],
      "pattern": "\\boffline\\s*=\\s*false\\b|^\\s*\\[\\s*(registries|registry|source|http)\\b",
      "shouldMatch": [
        "offline = false",
        "net.offline = false",
        "[source.crates-io]",
        "[registries.mirror]",
        "[http]"
      ],
      "shouldNotMatch": [
        "[net]",
        "offline = true",
        "# offline: nothing is downloaded after 0.1.0"
      ]
    }
  ]
}
