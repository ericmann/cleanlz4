  "build": ["cargo build --workspace --release"],
  "baseBranch": "main",
  "branchPrefix": "build/",
  "maxRounds": 3,
  "maxRoundsHard": 6,
  "flight": "cleanlz4",
  "mutation": {
    "targeted": {
      "cargo": { "cmd": "cargo test --workspace {filter}", "timeoutMs": 1800000 }
    }
  },
  "cleanroom": {
    "similarity": {
      "subject": ["crates/cleanlz4/src"],
      "pairs": [
        { "id": "independent-vs-c", "role": "negative", "left": "/home/ericmann/Projects/prior-art/lz4_flex/src", "right": "/home/ericmann/Projects/prior-art/lz4/lib" },
        { "id": "derived-vs-c", "role": "positive", "left": "/home/ericmann/Projects/prior-art/c2rust-lz4/src", "right": "/home/ericmann/Projects/prior-art/lz4/lib" },
        { "id": "subject-vs-c", "role": "test", "left": "subject", "right": "/home/ericmann/Projects/prior-art/lz4/lib" },
        { "id": "subject-vs-indep", "role": "test", "left": "subject", "right": "/home/ericmann/Projects/prior-art/lz4_flex/src" }
      ]
    }
  },
  "constraints": [
    {
      "id": "no-unsafe-token",
      "description": "SPEC 3.2: the token unsafe appears nowhere under crates/cleanlz4/ (the crate root's forbid(unsafe_code) attribute is not the token).",
      "paths": ["crates/cleanlz4/"],
      "pattern": "\\bunsafe\\b",
      "shouldMatch": [
        "    unsafe { core::ptr::read(p) }",
        "pub unsafe fn get_unchecked(i: usize) -> u8 {",
        "unsafe impl Send for Window {}",
        "// SAFETY: this unsafe block is fine"
      ],
      "shouldNotMatch": [
        "#![forbid(unsafe_code)]",
        "let b = buf.get(i).copied().ok_or(Error::TruncatedInput)?;"
      ]
    },
    {
      "id": "no-panic-lint-suppression",
      "description": "SPEC 3.3: library code never switches off the four panic lints (or clippy::all / clippy::restriction) with allow or expect.",
      "paths": ["crates/cleanlz4/src/"],
      "pattern": "\\b(allow|expect)\\s*\\([^)]*clippy::(unwrap_used|expect_used|panic|indexing_slicing|all|restriction)\\b",
      "shouldMatch": [
        "#[allow(clippy::unwrap_used)]",
        "#![allow(clippy::indexing_slicing, dead_code)]",
        "#[cfg_attr(feature = \"fast\", allow(clippy::panic))]",
        "#[expect(clippy::expect_used)]",
        "#[allow(clippy::all)]"
      ],
      "shouldNotMatch": [
        "#![cfg_attr(not(test), deny(clippy::unwrap_used, clippy::expect_used, clippy::panic, clippy::indexing_slicing))]",
        "#[allow(dead_code)]",
        "let v = opt.expect(\"present in tests\");"
      ]
    },
    {
      "id": "no-panicking-macros",
      "description": "SPEC 3.3: no unreachable!, todo! or unimplemented! under crates/cleanlz4/src/ (clippy::panic does not cover them).",
      "paths": ["crates/cleanlz4/src/"],
      "pattern": "\\b(unreachable|todo|unimplemented)!\\s*[(\\[{]",
      "shouldMatch": [
        "        _ => unreachable!(),",
        "todo!(\"legacy frames\")",
        "unimplemented! {}"
      ],
      "shouldNotMatch": [
        "// unreachable by construction, so this arm returns an error instead",
        "return Err(Error::TruncatedInput);"
      ]
    },
    {
      "id": "cleanlz4-independent-of-oracle",
      "description": "SPEC 4: crates/cleanlz4 never depends on crates/oracle and never mentions the oracle's binding crate.",
      "paths": ["crates/cleanlz4/"],
      "flags": "i",
      "pattern": "lz4[-_]sys|\\.\\./oracle|\\boracle\\s*=|\\boracle::|extern\\s+crate\\s+oracle",
      "shouldMatch": [
        "lz4-sys = \"1\"",
        "use lz4_sys::LZ4_decompress_safe;",
        "oracle = { path = \"../oracle\" }",
        "use oracle::ffi;",
        "extern crate oracle;"
      ],
      "shouldNotMatch": [
        "name = \"cleanlz4\"",
        "use crate::error::Error;",
        "// accepted because the oracle accepts it (docs/spikes/P1-06.md)"
      ]
    },
    {
      "id": "cleanlz4-no-extra-dependency-tables",
      "description": "SPEC 3.2: crates/cleanlz4/Cargo.toml has no dev-, build-, target- or per-crate dependency table; scripts/check-deps.sh proves the plain [dependencies] table is empty.",
      "paths": ["crates/cleanlz4/Cargo.toml"],
      "pattern": "^\\s*\\[\\s*(dev-dependencies|build-dependencies|target\\..*dependencies|(dev-|build-)?dependencies\\.[^\\]]+)\\s*\\]",
      "shouldMatch": [
        "[dev-dependencies]",
        "[build-dependencies]",
        "[dependencies.serde]",
        "[target.'cfg(unix)'.dependencies]"
      ],
      "shouldNotMatch": [
        "[dependencies]",
        "[package]",
        "[lints.clippy]"
      ]
    },
    {
      "id": "no-prior-art-crates",
      "description": "SPEC 3.1: no LZ4 or xxHash crate other than the oracle's binding crate is named in any manifest, lockfile or source file.",
      "paths": ["Cargo.toml", "Cargo.lock", "crates/", "fuzz/Cargo.toml", "fuzz/Cargo.lock", "fuzz/fuzz_targets/"],
      "flags": "i",
      "pattern": "\\b(lz4[-_]flex|twox[-_]hash|xxhash[-_]rust|lz[-_]fear|lzzzz|lz4[-_]compression|lz4[-_]java|python[-_]lz4)\\b|^\\s*(lz4|lz4_rs|xxhash|xxh3)\\s*=|^name = \"(lz4|xxhash|xxh3)\"$",
      "shouldMatch": [
        "lz4_flex = \"0.11\"",
        "twox-hash = { version = \"1\" }",
        "name = \"xxhash-rust\"",
        "lz4 = \"1.24\"",
        "name = \"lz4\"",
        "use lz_fear::framed::decompress_frame;"
      ],
      "shouldNotMatch": [
        "name = \"lz4-sys\"",
        "lz4-sys = \"1\"",
        "name = \"cleanlz4\"",
        "cleanlz4 = { path = \"../crates/cleanlz4\" }"
      ]
    },
    {
      "id": "oracle-calls-only-the-permitted-c-api",
      "description": "SPEC 3.7 and 6.5: the only reference-library functions called anywhere are the sixteen named in SPEC 6.5.",
      "paths": ["crates/oracle/", "fuzz/fuzz_targets/"],
      "pattern": "\\bLZ4F?_(?!(?:compress_default|compress_HC|compressBound|decompress_safe|decompress_safe_usingDict|createCompressionContext|compressBegin|compressUpdate|compressEnd|freeCompressionContext|createDecompressionContext|decompress|freeDecompressionContext|isError|getErrorName)\\s*\\()\\w+\\s*\\(",
      "shouldMatch": [
        "let n = LZ4_decompress_fast(src, dst, len);",
        "LZ4F_getFrameInfo(ctx, &mut info, p, &mut n)",
        "lz4_sys::LZ4F_flush(ctx, dst, cap, core::ptr::null())",
        "let v = LZ4_versionNumber();",
        "LZ4F_decompress_usingDict(ctx, a, b, c, d, e, f, g)",
        "LZ4_compress_fast(a, b, c, d, 1)"
      ],
      "shouldNotMatch": [
        "let n = LZ4_decompress_safe(src, dst, len, cap);",
        "LZ4F_decompress(ctx, dst, &mut dn, src, &mut sn, core::ptr::null())",
        "LZ4_decompress_safe_usingDict(s, d, sl, dc, dict, dl)",
        "let prefs: LZ4F_preferences_t = zeroed_prefs();",
        "LZ4F_isError(code) != 0",
        "LZ4_compress_HC(s, d, sl, dc, level)"
      ]
    },
    {
      "id": "binding-crate-only-in-ffi-module",
      "description": "SPEC 6.5: the binding crate is named in crates/oracle/src/ffi.rs (and crates/oracle/Cargo.toml) only; every other file goes through the oracle crate's safe wrappers.",
      "paths": ["crates/oracle/src/", "crates/oracle/tests/", "crates/oracle/examples/", "crates/oracle/benches/", "fuzz/fuzz_targets/", "fuzz/Cargo.toml"],
      "exclude": ["crates/oracle/src/ffi.rs"],
      "pattern": "lz4[-_]sys",
      "shouldMatch": [
        "use lz4_sys::*;",
        "lz4-sys = \"1\"",
        "let c = lz4_sys::LZ4_compressBound(n);"
      ],
      "shouldNotMatch": [
        "use crate::ffi;",
        "oracle = { path = \"../crates/oracle\" }"
      ]
    },
    {
      "id": "leaf-modules-import-only-error",
      "description": "SPEC 4: xxh32.rs, block.rs and error.rs import core and std only; the one crate-internal import they may make is crate::error.",
      "paths": ["crates/cleanlz4/src/xxh32.rs", "crates/cleanlz4/src/block.rs", "crates/cleanlz4/src/error.rs"],
      "pattern": "\\b(crate|super)::(frame|stream|block|xxh32)\\b|\\b(crate|super)::\\{",
      "shouldMatch": [
        "use crate::frame::FrameDescriptor;",
        "use super::stream::Decoder;",
        "use crate::{error::Error, xxh32::xxh32};",
        "let h = crate::xxh32::xxh32(data, 0);"
      ],
      "shouldNotMatch": [
        "use crate::error::Error;",
        "use crate::error::{Error, Result};",
        "use super::*;",
        "use core::cmp::min;"
      ]
    },
    {
      "id": "frame-does-not-import-stream",
      "description": "SPEC 4: frame.rs may import block and xxh32, never stream.",
      "paths": ["crates/cleanlz4/src/frame.rs"],
      "pattern": "\\b(crate|super)::stream\\b|\\b(crate|super)::\\{[^}]*\\bstream\\b",
      "shouldMatch": [
        "use crate::stream::Decoder;",
        "use crate::{block, stream};"
      ],
      "shouldNotMatch": [
        "use crate::block::decode_block;",
        "use crate::{block, xxh32};",
        "// the stream of blocks ends at the EndMark"
      ]
    },
    {
      "id": "no-hardcoded-output-limit",
      "description": "SPEC 3.5 and 5.1: limits.max_output_bytes (1 GiB) is written once, on the line that defines DEFAULT_MAX_OUTPUT_BYTES in crates/cleanlz4/src/lib.rs, and in testdata/config.json.",
      "paths": ["crates/", "fuzz/fuzz_targets/", "Makefile", "scripts/"],
      "pattern": "^(?!.*DEFAULT_MAX_OUTPUT_BYTES).*(\\b1073741824\\b|\\b1_073_741_824\\b|\\b1(u64|usize|u32|_u64|_usize)?\\s*<<\\s*30\\b|1024\\s*\\*\\s*1024\\s*\\*\\s*1024|\\b0x4000_?0000\\b)",
      "shouldMatch": [
        "let cap: u64 = 1 << 30;",
        "let cap = 1u64 << 30;",
        "max_output_bytes: 1073741824,",
        "const LIMIT: usize = 1_073_741_824;",
        "let cap = 1024 * 1024 * 1024;",
        "if total > 0x4000_0000 {"
      ],
      "shouldNotMatch": [
        "pub const DEFAULT_MAX_OUTPUT_BYTES: u64 = 1 << 30;",
        "max_output_bytes: DEFAULT_MAX_OUTPUT_BYTES,",
        "let cap = options.max_output_bytes;",
        "let high_bit = 1u32 << 31;"
      ]
    },
    {
      "id": "no-hardcoded-fuzz-tunables",
      "description": "SPEC 3.5 and 5.1: fuzz.seconds_per_target, fuzz.smoke_seconds and fuzz.seed are read from testdata/config.json, never written as literals in code, the Makefile or scripts.",
      "paths": ["crates/", "fuzz/fuzz_targets/", "Makefile", "scripts/"],
      "pattern": "max_total_time\\s*=\\s*[0-9]|-seed=[0-9]|\\b(seconds_per_target|smoke_seconds|fuzz_seed|SECONDS_PER_TARGET|SMOKE_SECONDS|FUZZ_SEED)\\s*(:\\s*\\w+\\s*)?([?+:]?=|:)\\s*[0-9]",
      "shouldMatch": [
        "cargo +nightly fuzz run $(TARGET) -- -max_total_time=3600",
        "let seconds_per_target = 3600;",
        "const SECONDS_PER_TARGET: u64 = 3600;",
        "seconds_per_target: 3600,",
        "SMOKE_SECONDS ?= 20",
        "args.push(\"-seed=1\".to_string());",
        "let fuzz_seed: u64 = 1;"
      ],
      "shouldNotMatch": [
        "format!(\"-max_total_time={}\", cfg.fuzz.seconds_per_target)",
        "pub seconds_per_target: u64,",
        "format!(\"-seed={}\", cfg.fuzz.seed)",
        "let seconds = cfg.fuzz.smoke_seconds;"
      ]
    },
    {
      "id": "no-hardcoded-bench-repeats",
      "description": "SPEC 3.5 and 5.1: bench.repeats is read from testdata/config.json, never written as a literal.",
      "paths": ["crates/", "fuzz/fuzz_targets/", "Makefile", "scripts/"],
      "pattern": "\\b(repeats|bench_repeats|REPEATS|BENCH_REPEATS)\\s*(:\\s*\\w+\\s*)?([?+:]?=|:)\\s*[0-9]",
      "shouldMatch": [
        "let repeats = 10;",
        "const REPEATS: usize = 10;",
        "repeats: 10,",
        "BENCH_REPEATS ?= 10"
      ],
      "shouldNotMatch": [
        "let repeats = cfg.bench.repeats;",
        "pub repeats: u32,",
        "for _ in 0..repeats {"
      ]
    },
    {
      "id": "no-hardcoded-chunking-cases",
      "description": "SPEC 3.5 and Phase 3: stream.chunking_cases (10,000) is read from testdata/config.json, never written as a literal.",
      "paths": ["crates/", "fuzz/fuzz_targets/", "Makefile", "scripts/"],
      "pattern": "\\b(chunking_cases|CHUNKING_CASES)\\s*(:\\s*\\w+\\s*)?([?+:]?=|:)\\s*[0-9]|\\bfor\\s+\\w+\\s+in\\s+0\\s*\\.\\.=?\\s*10_?000\\b",
      "shouldMatch": [
        "let chunking_cases = 10000;",
        "const CHUNKING_CASES: usize = 10_000;",
        "chunking_cases: 10000,",
        "for case in 0..10_000 {",
        "for i in 0..10000 {"
      ],
      "shouldNotMatch": [
        "let chunking_cases = cfg.stream.chunking_cases;",
        "pub chunking_cases: u64,",
        "for case in 0..cfg.stream.chunking_cases {"
      ]
    }
  ]
}
